# NOVA PULSE Environment Configuration
# Copy this file to .env and populate your personal keys

# Flask API Port
PORT=5000

# Secret Key for Sessions
SECRET_KEY=nova-pulse-production-secret-2026

# Google Gemini API Key (Optional: App includes fallback rule engine)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Gemini Model Version
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database Location
DATABASE_PATH=novapulse.db

# Debug Mode
DEBUG=False
